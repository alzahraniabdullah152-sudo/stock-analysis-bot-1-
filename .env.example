# Copy to .env and fill in. Never commit .env (it is in .gitignore).
DATA_PROVIDER=yfinance          # yfinance | alphavantage (used by the single-stock analysis page)
ALPHAVANTAGE_API_KEY=your_key_here
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
# SEC EDGAR asks every client to identify itself. Use your real name and email (needed for filings + financials).
SEC_USER_AGENT=Your Name your@email.com
LOG_LEVEL=INFO
# Optional overrides
OPENING_RANGE_MINUTES=30
ALERT_COOLDOWN_MINUTES=60
SCAN_INTERVAL_MINUTES=15
DEFAULT_ACCOUNT_EQUITY=10000
DEFAULT_RISK_PCT=1.0
COMMISSION_PER_SHARE=0.0
SLIPPAGE_PCT=0.05
